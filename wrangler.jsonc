{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mesas-electorales",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // Solo la API: la web estática la sirve GitHub Pages en el mismo dominio (registro DNS proxied en Cloudflare).
  "routes": [{ "pattern": "mesaselectorales.arandadeduero.dev/api/*", "zone_name": "arandadeduero.dev" }],
  // Listado de miembros de mesa (claves = HMAC del NIF). Se carga con `npm run kv:build` + `wrangler kv bulk put`.
  "kv_namespaces": [{ "binding": "MESAS", "id": "13b258fed94e464d8c9330627b7e9726" }],
  // Límite por IP exacto: un Durable Object por IP (1 consulta cada 10 s, 10 captchas por minuto; ver LIMITES en src/worker.js).
  "durable_objects": { "bindings": [{ "name": "LIMITE_IP", "class_name": "LimiteIp" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LimiteIp"] }],
  // Dominios aceptados en la respuesta de Turnstile (Siteverify). En local, .dev.vars sustituye estas variables.
  "vars": {
    "TURNSTILE_HOSTNAMES": "mesaselectorales.arandadeduero.dev",
    // Origin aceptado en POST /api/consulta (protección frente a peticiones desde otras webs)
    "ORIGENES": "https://mesaselectorales.arandadeduero.dev"
  },
  "observability": { "enabled": false }
  // Secretos (no van aquí): NIF_KEY y TURNSTILE_SECRET, con `wrangler secret put`. En local, en .dev.vars.
}
